# Bancos de dados locais — nunca versionar (dados internos de pagamento/CNES,
# este repo faz deploy automatico para site publico no Render).
*.db
*.db-journal

# Bases de dados em Excel/CSV — nao versionar (ver CLAUDE.md).
*.xlsx
*.xls
*.csv
!docs/*.csv

# Arquivos de bloqueio/lixo do Office e do Windows.
~$*
desktop.ini

# Power BI.
*.pbix

# Cache Python.
__pycache__/
*.pyc

# Arquivos privados: nunca distribuir pelo frontend estatico.
/sync.php
/.env
/.env.*
/.github_token
/.claude/settings.local.json
/docs/ACESSOS*.md
/docs/*local.md
/docs/*LOCAL.md
/docs/validacoes-locais/
*.db
*.db-journal
